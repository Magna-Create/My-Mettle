#!/usr/bin/env sh
set -eu

# Share the Gradle bootstrap used by the normal My Mettle Termux build.
# The original LAB-2B launcher incorrectly required a separate Gradle on PATH.
GRADLE_VERSION="9.3.1"
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
CACHE_ROOT="${GRADLE_USER_HOME:-$HOME/.gradle}/my-mettle-bootstrap"
DIST_DIR="$CACHE_ROOT/gradle-$GRADLE_VERSION"
GRADLE_BIN="$DIST_DIR/bin/gradle"
ZIP_PATH="$CACHE_ROOT/gradle-$GRADLE_VERSION-bin.zip"
DIST_URL="https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip"

if [ -n "${PREFIX:-}" ] && [ -x "$PREFIX/lib/jvm/java-17-openjdk/bin/java" ]; then
    JAVA_HOME="$PREFIX/lib/jvm/java-17-openjdk"
    export JAVA_HOME
    PATH="$JAVA_HOME/bin:$PATH"
    export PATH
fi

if [ ! -x "$GRADLE_BIN" ]; then
    if command -v gradle >/dev/null 2>&1 &&
       [ "$(gradle --version | awk '$1 == "Gradle" { print $2; exit }')" = "$GRADLE_VERSION" ]; then
        GRADLE_BIN="$(command -v gradle)"
    else
        mkdir -p "$CACHE_ROOT"
        if [ ! -f "$ZIP_PATH" ]; then
            printf '%s\n' "LAB-2B: downloading shared Gradle $GRADLE_VERSION..." >&2
            if command -v curl >/dev/null 2>&1; then
                curl -fL --retry 3 --output "$ZIP_PATH" "$DIST_URL"
            elif command -v wget >/dev/null 2>&1; then
                wget -O "$ZIP_PATH" "$DIST_URL"
            else
                printf '%s\n' "Install curl or wget to bootstrap Gradle." >&2
                exit 1
            fi
        fi
        command -v unzip >/dev/null 2>&1 || {
            printf '%s\n' "Install unzip and run ./gradlew again." >&2
            exit 1
        }
        rm -rf "$DIST_DIR"
        unzip -q "$ZIP_PATH" -d "$CACHE_ROOT"
    fi
fi

# On the phone the user is testing OCR and Cloud Vision, not the MNN model
# comparison runtime; prevent NDK/JNI work and never require a native bundle.
if [ -n "${PREFIX:-}" ] && [ -x "$PREFIX/bin/aapt2" ]; then
    exec "$GRADLE_BIN" -p "$APP_HOME" -Plab2bOcrOnly=true \
        "-Pandroid.aapt2FromMavenOverride=$PREFIX/bin/aapt2" "$@"
fi

exec "$GRADLE_BIN" -p "$APP_HOME" "$@"
